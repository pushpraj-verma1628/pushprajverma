<script>
(function(){
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.getElementById('yr').textContent = new Date().getFullYear();

  // Projects
  const sites = [
    ['Nimbuspost','nimbuspost.com','India','#2563EB','#7C3AED'],
    ['My Expert Web','myexpertweb.com','International','#0EA5E9','#22C55E'],
    ['GoGoWash','gogowash.com.sg','Singapore','#2F7BF6','#1BC5D8'],
    ['Furbotics','furbotics.com.sg','Singapore','#F2994A','#EB5757'],
    ['Pool Party','www.poolparty.com','International','#00B4DB','#0083B0'],
    ['MediGlow','www.mediglow.ie','Ireland','#C471ED','#F64F59'],
    ['QES Academy','qesacademy.com','International','#11998E','#38EF7D'],
    ['QE Safety','qesafety.com','International','#F7971E','#E8B100'],
    ['Kenny Windows','www.kennywindows.ie','Ireland','#4568DC','#B06AB3'],
    ['Be Brave Brand','www.beabravebrand.com','International','#EC008C','#FC6767'],
    ['Digital AI Works','digitalaiworks.com','International','#6A3FEA','#3557F5'],
    ['ProSource Medical','prosourcemedical.ie','Ireland','#0F9B8E','#2B5876']
  ];
  const initials = n => n.split(' ').map(w=>w[0]).join('').slice(0,3);
  const list = document.getElementById('work-list');
  sites.forEach(([n,d,w,a,b],i)=>{
    const li = document.createElement('li');
    li.className = 'reveal';
    li.style.transitionDelay = (i%4)*70 + 'ms';
    li.innerHTML = `<a class="proj" href="https://${d}" target="_blank" rel="noopener" style="--a:${a};--b:${b}">
      <div class="thumb"><b>${initials(n)}</b></div>
      <div class="meta"><strong>${n}</strong><span>${d.replace('www.','')}</span><span>${w}</span><em>Visit site</em></div></a>`;
    list.appendChild(li);
  });

  // Marquee duplicate
  const track = document.getElementById('track');
  track.innerHTML += track.innerHTML;

  // Typewriter
  const words = ['WordPress websites','Shopify stores','custom plugins','WooCommerce shops','React interfaces','fast, secure sites'];
  const el = document.getElementById('word');
  if(!reduce){
    let wi=0, ci=words[0].length, del=true;
    const tick=()=>{
      const w=words[wi];
      if(del){ ci--; el.textContent=w.slice(0,ci); if(ci===0){del=false; wi=(wi+1)%words.length;} setTimeout(tick,40); }
      else { const nw=words[wi]; ci++; el.textContent=nw.slice(0,ci); if(ci===nw.length){del=true; setTimeout(tick,1800);} else setTimeout(tick,75); }
    };
    setTimeout(tick,2200);
  }

  // Browser cycling through live sites
  const br = document.getElementById('browser');
  let si = 0;
  const show = i=>{
    const [n,d,w,a] = sites[i];
    br.style.setProperty('--c', a);
    document.getElementById('url').textContent = d.replace('www.','');
    document.getElementById('sname').textContent = n;
    document.getElementById('where').textContent = 'Live client site' + (w==='International' ? '' : ' in ' + w);
    const v = document.getElementById('visit'); v.href = 'https://' + d;
    br.classList.remove('run'); void br.offsetWidth; br.classList.add('run');
  };
  show(0);
  if(!reduce) setInterval(()=>{ si=(si+1)%sites.length; show(si); }, 3600);

  // Counters
  const count = el=>{
    const end=parseFloat(el.dataset.count), dec=+(el.dataset.dec||0), suf=el.dataset.suf||'';
    if(reduce){ el.textContent=end.toFixed(dec)+suf; return; }
    const t0=performance.now(), dur=1600;
    const step=t=>{ const p=Math.min((t-t0)/dur,1), e=1-Math.pow(1-p,3);
      el.textContent=(end*e).toFixed(dec)+suf; if(p<1) requestAnimationFrame(step); };
    requestAnimationFrame(step);
  };
  setTimeout(()=>document.querySelectorAll('[data-count]').forEach(count), 700);

  // Reveal on scroll
  if('IntersectionObserver' in window){
    const io = new IntersectionObserver(es=>es.forEach(e=>{ if(e.isIntersecting){ e.target.classList.add('in'); io.unobserve(e.target);} }),{threshold:.15});
    document.querySelectorAll('.reveal').forEach(r=>io.observe(r));
  } else document.querySelectorAll('.reveal').forEach(r=>r.classList.add('in'));

  // Scroll progress, back to top, timeline draw
  const prog=document.getElementById('prog'), toTop=document.getElementById('totop'), tl=document.querySelector('.timeline');
  toTop.addEventListener('click',()=>window.scrollTo({top:0,behavior:reduce?'auto':'smooth'}));
  const onScroll=()=>{
    const h=document.documentElement, p=h.scrollTop/((h.scrollHeight-h.clientHeight)||1);
    prog.style.transform='scaleX('+p+')';
    toTop.classList.toggle('show', h.scrollTop>600);
    if(tl && !reduce){ const r=tl.getBoundingClientRect(); const v=Math.min(Math.max((innerHeight*0.8-r.top)/r.height,0),1); tl.style.setProperty('--draw',v); }
  };
  addEventListener('scroll',onScroll,{passive:true}); onScroll();

  // Spotlight glow on cards
  document.querySelectorAll('.card,.job,.proj').forEach(el=>{
    el.classList.add('spot');
    el.addEventListener('pointermove',e=>{const r=el.getBoundingClientRect(); el.style.setProperty('--mx',(e.clientX-r.left)+'px'); el.style.setProperty('--my',(e.clientY-r.top)+'px');});
  });

  if(!reduce){
    const fine=matchMedia('(hover:hover) and (pointer:fine)').matches;
    if(fine){
      // 3D tilt on project cards
      document.querySelectorAll('.proj').forEach(el=>{
        el.addEventListener('pointermove',e=>{const r=el.getBoundingClientRect(),x=(e.clientX-r.left)/r.width-.5,y=(e.clientY-r.top)/r.height-.5;
          el.style.transform='perspective(700px) rotateY('+(x*12)+'deg) rotateX('+(-y*12)+'deg) translateY(-6px)';});
        el.addEventListener('pointerleave',()=>el.style.transform='');
      });
      // Magnetic buttons
      document.querySelectorAll('.btn').forEach(b=>{
        b.addEventListener('pointermove',e=>{const r=b.getBoundingClientRect(); b.style.transform='translate('+((e.clientX-r.left-r.width/2)*.25)+'px,'+((e.clientY-r.top-r.height/2)*.35)+'px)';});
        b.addEventListener('pointerleave',()=>b.style.transform='');
      });
    }

    // Scramble-in section headings
    const chars='ABCDEFGHIJKLMNOPQRSTUVWXYZ</>{}#';
    const scramble=el=>{const fin=el.textContent; el.setAttribute('aria-label',fin); let f=0;
      const iv=setInterval(()=>{ el.textContent=fin.split('').map((ch,i)=>ch===' '?' ':(i<f/2?ch:chars[Math.floor(Math.random()*chars.length)])).join(''); f++;
        if(f>=fin.length*2){clearInterval(iv); el.textContent=fin;} },28);};
    const so=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting){scramble(e.target);so.unobserve(e.target);}}),{threshold:.6});
    document.querySelectorAll('.head h2, .cta h2').forEach(h=>so.observe(h));

    // Interactive particle network in hero
    const cv=document.getElementById('net');
    if(cv && cv.getContext){
      const ctx=cv.getContext('2d'), hero=cv.parentElement; let W=0,H=0,pts=[],mouse={x:-999,y:-999},vis=true,rgb='53,87,245';
      const readColor=()=>{const h=getComputedStyle(document.documentElement).getPropertyValue('--blue').trim(); if(/^#[0-9a-f]{6}$/i.test(h)){const n=parseInt(h.slice(1),16); rgb=[(n>>16)&255,(n>>8)&255,n&255].join(',');}};
      readColor(); const mq=matchMedia('(prefers-color-scheme: dark)'); mq.addEventListener&&mq.addEventListener('change',readColor);
      const size=()=>{const dpr=Math.min(devicePixelRatio||1,2); W=hero.offsetWidth; H=hero.offsetHeight; cv.width=W*dpr; cv.height=H*dpr; cv.style.width=W+'px'; cv.style.height=H+'px'; ctx.setTransform(dpr,0,0,dpr,0,0);
        const n=Math.round(Math.min(90,W*H/13000)); pts=Array.from({length:n},()=>({x:Math.random()*W,y:Math.random()*H,vx:(Math.random()-.5)*.45,vy:(Math.random()-.5)*.45}));};
      size(); let rt; addEventListener('resize',()=>{clearTimeout(rt); rt=setTimeout(size,200);});
      hero.addEventListener('pointermove',e=>{const r=hero.getBoundingClientRect(); mouse.x=e.clientX-r.left; mouse.y=e.clientY-r.top;});
      hero.addEventListener('pointerleave',()=>{mouse.x=mouse.y=-999;});
      new IntersectionObserver(([e])=>{vis=e.isIntersecting;}).observe(hero);
      const draw=()=>{ requestAnimationFrame(draw); if(!vis) return; ctx.clearRect(0,0,W,H);
        for(const p of pts){ p.x+=p.vx; p.y+=p.vy; if(p.x<0||p.x>W)p.vx*=-1; if(p.y<0||p.y>H)p.vy*=-1;
          const dx=p.x-mouse.x, dy=p.y-mouse.y, d=Math.hypot(dx,dy)||1; if(d<110){p.x+=dx/d*1.4; p.y+=dy/d*1.4;}
          ctx.fillStyle='rgba('+rgb+',.6)'; ctx.beginPath(); ctx.arc(p.x,p.y,1.8,0,6.3); ctx.fill(); }
        ctx.lineWidth=1;
        for(let i=0;i<pts.length;i++){ const a=pts[i];
          for(let j=i+1;j<pts.length;j++){ const b=pts[j], d=Math.hypot(a.x-b.x,a.y-b.y); if(d<130){ctx.strokeStyle='rgba('+rgb+','+((1-d/130)*.32)+')'; ctx.beginPath(); ctx.moveTo(a.x,a.y); ctx.lineTo(b.x,b.y); ctx.stroke();} }
          const dm=Math.hypot(a.x-mouse.x,a.y-mouse.y); if(dm<190){ctx.strokeStyle='rgba('+rgb+','+((1-dm/190)*.6)+')'; ctx.beginPath(); ctx.moveTo(a.x,a.y); ctx.lineTo(mouse.x,mouse.y); ctx.stroke();}
        }
      };
      draw();
    }
  }
})();
</script>
