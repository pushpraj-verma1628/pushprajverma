<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Pushpraj Verma — WordPress & Shopify Developer</title>
<meta name="description" content="Pushpraj Verma, full-stack WordPress and Shopify developer based in Noida, India.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Unbounded:wght@500;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@500&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#F3F5FB; --surface:#FFFFFF; --surface-2:#E9EDF7; --ink:#121733; --muted:#5A6283; --line:#DCE1EE;
  --blue:#3557F5; --green:#18A867; --violet:#7B4DFF; --on-accent:#FFFFFF;
  --glass:rgba(255,255,255,.72); --shadow:0 24px 60px -28px rgba(30,40,90,.35);
  color-scheme:light; box-sizing:border-box;
  padding-top:env(safe-area-inset-top,0px); padding-bottom:env(safe-area-inset-bottom,0px);
}
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]){
    --bg:#0D1124; --surface:#161B33; --surface-2:#1E2442; --ink:#EEF0FA; --muted:#A1A8C8; --line:#272E52;
    --blue:#6D88FF; --green:#3DDC93; --violet:#A386FF; --on-accent:#0D1124;
    --glass:rgba(13,17,36,.72); --shadow:0 24px 60px -24px rgba(0,0,0,.7); color-scheme:dark;
  }
}
:root[data-theme="dark"]{
  --bg:#0D1124; --surface:#161B33; --surface-2:#1E2442; --ink:#EEF0FA; --muted:#A1A8C8; --line:#272E52;
  --blue:#6D88FF; --green:#3DDC93; --violet:#A386FF; --on-accent:#0D1124;
  --glass:rgba(13,17,36,.72); --shadow:0 24px 60px -24px rgba(0,0,0,.7); color-scheme:dark;
}
html{scroll-padding-top:calc(env(safe-area-inset-top,0px) + 72px);scroll-behavior:smooth}
*,*::before,*::after{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font-family:"Plus Jakarta Sans",system-ui,-apple-system,"Segoe UI",sans-serif;font-size:1.0625rem;line-height:1.6;-webkit-font-smoothing:antialiased;overflow-x:hidden}
body::before{content:"";position:fixed;inset:0 0 auto;height:env(safe-area-inset-top,0px);z-index:60;background:var(--glass);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px)}
a{color:inherit}
:focus-visible{outline:3px solid var(--blue);outline-offset:3px;border-radius:6px}
.wrap{max-width:1140px;margin:0 auto;padding:0 1.25rem}
h1,h2,h3{margin:0;line-height:1.1}
h2{font-family:"Unbounded","Plus Jakarta Sans",system-ui,sans-serif;font-weight:700;font-size:clamp(1.7rem,3.6vw,2.5rem);letter-spacing:-0.02em}
.grad{background:linear-gradient(100deg,var(--blue),var(--violet) 50%,var(--green));-webkit-background-clip:text;background-clip:text;color:transparent}

/* Header */
header.top{position:sticky;top:env(safe-area-inset-top,0px);z-index:50;background:var(--glass);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);border-bottom:1px solid var(--line)}
header.top .wrap{display:flex;align-items:center;justify-content:space-between;height:64px;gap:1rem}
.logo{display:flex;align-items:center;gap:.6rem;text-decoration:none;font-weight:700}
.logo i{width:34px;height:34px;border-radius:10px;display:grid;place-items:center;font:700 .85rem "Unbounded",sans-serif;font-style:normal;color:#fff;background:linear-gradient(135deg,var(--blue),var(--violet))}
nav ul{list-style:none;display:flex;align-items:center;gap:1.5rem;margin:0;padding:0;font-size:.95rem;font-weight:500}
nav a{text-decoration:none;color:var(--muted);transition:color .2s}
nav a:hover{color:var(--ink)}
@media (max-width:720px){nav li:not(:last-child){display:none}}
.btn{display:inline-flex;align-items:center;gap:.5rem;padding:.85rem 1.45rem;border-radius:999px;font-weight:600;text-decoration:none;border:1.5px solid var(--line);background:var(--surface);color:var(--ink);transition:transform .2s,box-shadow .2s,border-color .2s}
.btn:hover{transform:translateY(-2px);border-color:var(--ink)}
.btn.primary{border:0;color:#fff;background:linear-gradient(110deg,var(--blue),var(--violet));box-shadow:0 12px 30px -12px var(--blue)}
.btn.primary:hover{box-shadow:0 18px 36px -12px var(--violet)}
.btn.sm{padding:.55rem 1.05rem;font-size:.9rem}
nav a.btn.primary{color:#fff}

/* Hero */
.hero{position:relative;padding:3.5rem 0 4rem;isolation:isolate}
.blob{position:absolute;border-radius:50%;filter:blur(70px);opacity:.45;z-index:-1;animation:drift 18s ease-in-out infinite alternate}
.b1{width:420px;height:420px;background:var(--blue);top:-120px;left:-120px}
.b2{width:360px;height:360px;background:var(--green);bottom:-80px;right:8%;animation-delay:-6s;opacity:.3}
.b3{width:300px;height:300px;background:var(--violet);top:20%;right:-80px;animation-delay:-12s;opacity:.35}
@keyframes drift{to{transform:translate(60px,40px) scale(1.12)}}
.hero-grid{display:grid;grid-template-columns:1.05fr 1fr;gap:3rem;align-items:center}
@media (max-width:900px){.hero-grid{grid-template-columns:1fr;gap:2.5rem}}
.status{display:inline-flex;align-items:center;gap:.55rem;padding:.4rem .9rem;border-radius:999px;background:var(--surface);border:1px solid var(--line);font-size:.88rem;font-weight:500;color:var(--muted)}
.pulse{width:9px;height:9px;border-radius:50%;background:var(--green);box-shadow:0 0 0 0 var(--green);animation:pulse 2s infinite}
@keyframes pulse{70%{box-shadow:0 0 0 10px transparent}100%{box-shadow:0 0 0 0 transparent}}
.hero h1{font-family:"Unbounded",system-ui,sans-serif;font-weight:800;font-size:clamp(2.5rem,6.4vw,4.6rem);letter-spacing:-0.035em;margin:1.2rem 0 .8rem}
.typed{font-size:clamp(1.15rem,2.4vw,1.5rem);font-weight:600;min-height:2.2em;margin:0}
.typed .word{color:var(--blue)}
.typed .caret{display:inline-block;width:2px;height:1.1em;background:var(--blue);vertical-align:-.15em;margin-left:2px;animation:blink 1s steps(1) infinite}
@keyframes blink{50%{opacity:0}}
.lede{color:var(--muted);max-width:42ch;margin:.6rem 0 1.8rem}
.ctas{display:flex;flex-wrap:wrap;gap:.75rem}
.stats{display:grid;grid-template-columns:repeat(3,auto);justify-content:start;gap:2.25rem;margin-top:2.2rem}
.stat b{display:block;font:700 clamp(1.7rem,3.4vw,2.3rem)/1 "Unbounded",sans-serif;letter-spacing:-0.03em}
.stat span{font-size:.88rem;color:var(--muted)}
@media (max-width:420px){.stats{gap:1.25rem}}

/* Live browser */
.browser{position:relative;background:var(--surface);border:1px solid var(--line);border-radius:20px;box-shadow:var(--shadow);overflow:hidden;--c:#3557F5;transform:perspective(1200px) rotateY(-6deg) rotateX(3deg);transition:transform .6s}
.browser:hover{transform:none}
@media (max-width:900px){.browser{transform:none}}
.chrome{display:flex;align-items:center;gap:.8rem;padding:.75rem 1rem;background:var(--surface-2);border-bottom:1px solid var(--line)}
.dots{display:flex;gap:6px}.dots i{width:11px;height:11px;border-radius:50%;background:#FF6159}.dots i:nth-child(2){background:#FFBD2E}.dots i:nth-child(3){background:#28C941}
.url{flex:1;display:flex;align-items:center;gap:.45rem;padding:.35rem .8rem;border-radius:8px;background:var(--surface);font:500 .8rem "JetBrains Mono",ui-monospace,monospace;color:var(--muted);overflow:hidden;white-space:nowrap}
.url svg{flex:none;color:var(--green)}
.load{height:3px;background:transparent;position:relative}
.load i{position:absolute;inset:0 auto 0 0;width:0;background:var(--c)}
.browser.run .load i{animation:load 1.1s ease-out forwards}
@keyframes load{to{width:100%;opacity:0}}
.site{padding:1.2rem;display:grid;gap:.9rem;min-height:300px}
.sk{border-radius:8px;background:var(--surface-2)}
.browser.run .sk{animation:pop .55s cubic-bezier(.2,.9,.3,1.3) both}
@keyframes pop{from{opacity:0;transform:translateY(10px) scale(.96)}}
.s-nav{display:flex;justify-content:space-between;align-items:center}
.s-logo{width:82px;height:16px;background:var(--c)!important;opacity:.9}
.s-links{display:flex;gap:8px}.s-links .sk{width:38px;height:9px}
.s-hero{display:grid;grid-template-columns:1.2fr 1fr;gap:.9rem;padding:1rem;border-radius:12px;background:color-mix(in srgb,var(--c) 12%,var(--surface))}
.s-title{font:700 1.15rem/1.15 "Unbounded",sans-serif;letter-spacing:-0.02em;color:var(--ink);margin:0 0 .5rem}
.s-line{height:8px;margin:.35rem 0}
.s-btn{width:84px;height:24px;border-radius:999px;margin-top:.7rem;background:var(--c)!important}
.s-img{border-radius:10px;background:linear-gradient(135deg,var(--c),color-mix(in srgb,var(--c) 40%,#fff))!important;min-height:110px}
.s-cards{display:grid;grid-template-columns:repeat(3,1fr);gap:.7rem}
.s-cards .sk{height:64px}
.tagline{display:flex;justify-content:space-between;align-items:center;padding:.8rem 1.2rem;border-top:1px solid var(--line);font-size:.85rem;color:var(--muted)}
.tagline a{font-weight:600;color:var(--blue);text-decoration:none}
.chip-float{position:absolute;padding:.5rem .85rem;border-radius:12px;background:var(--surface);border:1px solid var(--line);box-shadow:var(--shadow);font-size:.82rem;font-weight:600;display:flex;align-items:center;gap:.4rem;animation:float 5s ease-in-out infinite}
.chip-float.f1{top:44%;left:-26px}.chip-float.f2{bottom:68px;right:-18px;animation-delay:-2.5s}
@keyframes float{50%{transform:translateY(-10px)}}
@media (max-width:900px){.chip-float{display:none}}
.hero-right{position:relative}

/* Marquee */
.marquee{border-block:1px solid var(--line);background:var(--surface);overflow:hidden;padding:1rem 0}
.track{display:flex;gap:2.75rem;width:max-content;animation:scroll 32s linear infinite}
.marquee:hover .track{animation-play-state:paused}
.track span{font:600 1.05rem "Unbounded",sans-serif;color:var(--muted);white-space:nowrap;display:flex;align-items:center;gap:2.75rem}
.track span::after{content:"";width:8px;height:8px;border-radius:50%;background:linear-gradient(135deg,var(--blue),var(--green))}
@keyframes scroll{to{transform:translateX(-50%)}}

/* Sections */
section{padding:5rem 0}
.head{display:flex;justify-content:space-between;align-items:end;gap:1.5rem;flex-wrap:wrap;margin-bottom:2.5rem}
.head p{color:var(--muted);max-width:46ch;margin:.6rem 0 0}

/* Services bento */
.bento{display:grid;grid-template-columns:repeat(6,1fr);gap:1rem}
.card{position:relative;background:var(--surface);border:1px solid var(--line);border-radius:20px;padding:1.6rem;overflow:hidden;transition:transform .3s,border-color .3s}
.card:hover{transform:translateY(-4px);border-color:color-mix(in srgb,var(--blue) 50%,var(--line))}
.card h3{font-family:"Unbounded",sans-serif;font-size:1.2rem;font-weight:700;letter-spacing:-0.02em;margin-bottom:.5rem}
.card p{color:var(--muted);margin:0;font-size:.97rem}
.card ul{margin:.9rem 0 0;padding:0;list-style:none;display:flex;flex-wrap:wrap;gap:.4rem}
.card li{font-size:.82rem;font-weight:500;padding:.3rem .7rem;border-radius:999px;background:var(--surface-2)}
.ic{width:46px;height:46px;border-radius:14px;display:grid;place-items:center;margin-bottom:1.1rem;color:#fff}
.c-wp{grid-column:span 3}.c-shop{grid-column:span 3}.c-sm{grid-column:span 2}
.c-wp .ic{background:var(--blue)}.c-shop .ic{background:var(--green)}
.c-sm .ic{background:var(--violet)}
.card.c-wp::after,.card.c-shop::after{content:"";position:absolute;width:220px;height:220px;border-radius:50%;right:-80px;bottom:-110px;opacity:.14;background:var(--blue)}
.card.c-shop::after{background:var(--green)}
@media (max-width:860px){.c-wp,.c-shop{grid-column:span 6}.c-sm{grid-column:span 3}}
@media (max-width:560px){.c-sm{grid-column:span 6}}

/* Work */
.work{display:grid;grid-template-columns:repeat(auto-fill,minmax(250px,1fr));gap:1rem;list-style:none;margin:0;padding:0}
.proj{display:flex;flex-direction:column;height:100%;text-decoration:none;background:var(--surface);border:1px solid var(--line);border-radius:20px;overflow:hidden;transition:transform .3s,box-shadow .3s}
.proj:hover{transform:translateY(-6px);box-shadow:var(--shadow)}
.thumb{height:120px;display:grid;place-items:center;position:relative;overflow:hidden;background:linear-gradient(135deg,var(--a),var(--b))}
.thumb b{font:800 2.2rem "Unbounded",sans-serif;color:rgba(255,255,255,.95);letter-spacing:-0.04em;transition:transform .4s}
.proj:hover .thumb b{transform:scale(1.12) rotate(-3deg)}
.thumb::after{content:"";position:absolute;inset:0;background:linear-gradient(120deg,transparent 30%,rgba(255,255,255,.35) 50%,transparent 70%);transform:translateX(-100%);transition:transform .7s}
.proj:hover .thumb::after{transform:translateX(100%)}
.meta{padding:1rem 1.2rem 1.2rem;display:flex;flex-direction:column;gap:.15rem;flex:1}
.meta strong{font-size:1.1rem}
.meta span{color:var(--muted);font-size:.88rem}
.meta em{font-style:normal;margin-top:auto;padding-top:.7rem;font-weight:600;font-size:.88rem;color:var(--blue)}

/* Experience */
.timeline{list-style:none;margin:0;padding:0;position:relative}
.timeline::before{content:"";position:absolute;left:11px;top:6px;bottom:6px;width:2px;background:linear-gradient(var(--blue),var(--violet),var(--green))}
.timeline>li{position:relative;padding:0 0 1.25rem 3rem}
.timeline>li::before{content:"";position:absolute;left:4px;top:1.45rem;width:16px;height:16px;border-radius:50%;background:var(--bg);border:3px solid var(--blue)}
.timeline>li.now::before{background:var(--green);border-color:var(--green);box-shadow:0 0 0 6px color-mix(in srgb,var(--green) 25%,transparent)}
.job{background:var(--surface);border:1px solid var(--line);border-radius:18px;padding:1.3rem 1.5rem}
.job .row{display:flex;justify-content:space-between;flex-wrap:wrap;gap:.3rem 1rem;align-items:baseline}
.job h3{font-size:1.15rem;font-weight:700}
.job .when{font-size:.85rem;font-weight:600;color:var(--blue)}
.job .role{color:var(--muted);margin:.15rem 0 0;font-weight:500}
.job ul{margin:.8rem 0 0;padding-left:1.1rem;color:var(--muted);font-size:.95rem}
.job ul li{margin:.2rem 0}

/* Skills + edu */
.skillgrid{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:1rem}
.bar{margin:.75rem 0 0}
.bar div{display:flex;justify-content:space-between;font-size:.9rem;font-weight:600}
.bar .t{height:8px;border-radius:99px;background:var(--surface-2);margin-top:.35rem;overflow:hidden}
.bar .t i{display:block;height:100%;width:0;border-radius:99px;background:linear-gradient(90deg,var(--blue),var(--violet));transition:width 1.4s cubic-bezier(.2,.8,.2,1)}
.in .bar .t i{width:var(--w)}

/* Contact */
.cta{position:relative;overflow:hidden;border-radius:28px;padding:clamp(2rem,6vw,4rem);color:#fff;background:linear-gradient(125deg,#2A45D8,#6A3FEA 55%,#119E61)}
.cta h2{font-size:clamp(2rem,5vw,3.4rem);max-width:15ch;color:#fff}
.cta p{opacity:.88;max-width:44ch;margin:1rem 0 2rem}
.cta .btn{background:#fff;color:#18205A;border:0}
.cta .btn.ghost{background:rgba(255,255,255,.14);color:#fff;border:1.5px solid rgba(255,255,255,.45)}
.cta .ring{position:absolute;border:1.5px solid rgba(255,255,255,.22);border-radius:50%;animation:spin 30s linear infinite}
.cta .r1{width:420px;height:420px;right:-120px;top:-140px;border-style:dashed}
.cta .r2{width:260px;height:260px;right:40px;bottom:-140px}
@keyframes spin{to{transform:rotate(360deg)}}
.contact-list{display:flex;flex-wrap:wrap;gap:1rem 2rem;margin-top:2rem;font-size:.95rem;position:relative}
.contact-list a{text-decoration:none}
footer{padding:2rem 0 3rem;color:var(--muted);font-size:.9rem;text-align:center}

/* Extra motion */
#net{position:absolute;inset:0;z-index:-1;pointer-events:none}
#prog{position:fixed;top:env(safe-area-inset-top,0px);left:0;right:0;height:3px;z-index:70;transform-origin:left;transform:scaleX(0);background:linear-gradient(90deg,var(--blue),var(--violet),var(--green))}
#totop{position:fixed;right:1.25rem;bottom:calc(1.25rem + env(safe-area-inset-bottom,0px));z-index:55;width:48px;height:48px;border-radius:50%;border:0;display:grid;place-items:center;color:#fff;background:linear-gradient(135deg,var(--blue),var(--violet));box-shadow:var(--shadow);cursor:pointer;opacity:0;transform:translateY(20px) scale(.8);pointer-events:none;transition:opacity .35s,transform .35s cubic-bezier(.2,.9,.3,1.4)}
#totop.show{opacity:1;transform:none;pointer-events:auto}
.hero .grad{background-image:linear-gradient(100deg,var(--blue),var(--violet),var(--green),var(--blue));background-size:300% auto;animation:shine 5s ease-in-out infinite alternate}
@keyframes shine{to{background-position:100% 50%}}
.btn.primary{position:relative;overflow:hidden}
.btn.primary::after{content:"";position:absolute;inset:0;background:linear-gradient(120deg,transparent 30%,rgba(255,255,255,.5) 50%,transparent 70%);transform:translateX(-120%);animation:sheen 4.5s ease-in-out infinite;pointer-events:none}
@keyframes sheen{55%,100%{transform:translateX(120%)}}
.spot{position:relative}
.spot::before{content:"";position:absolute;inset:0;border-radius:inherit;pointer-events:none;z-index:1;background:radial-gradient(320px circle at var(--mx,50%) var(--my,50%),color-mix(in srgb,var(--blue) 16%,transparent),transparent 65%);opacity:0;transition:opacity .35s}
.spot:hover::before{opacity:1}
.timeline::before{transform-origin:top;transform:scaleY(var(--draw,1));transition:transform .2s linear}
.stat b{background:linear-gradient(180deg,var(--ink),color-mix(in srgb,var(--ink) 55%,var(--blue)));-webkit-background-clip:text;background-clip:text;color:transparent}
.status{animation:glowring 3s ease-in-out infinite}
@keyframes glowring{50%{box-shadow:0 0 0 4px color-mix(in srgb,var(--green) 18%,transparent)}}

/* Reveal */
.js .card.reveal.in:hover{transform:translateY(-4px)}
.js .reveal{opacity:0;transform:translateY(28px);transition:opacity .8s ease,transform .8s cubic-bezier(.2,.8,.2,1)}
.js .reveal.in{opacity:1;transform:none}
.js .hero .intro-anim{opacity:0;transform:translateY(20px);animation:rise .9s cubic-bezier(.2,.8,.2,1) forwards}
@keyframes rise{to{opacity:1;transform:none}}
@media (prefers-reduced-motion: reduce){
  *,*::before,*::after{animation:none!important;transition:none!important}
  .js .reveal,.js .hero .intro-anim{opacity:1;transform:none}
  .bar .t i{width:var(--w)}
  html{scroll-behavior:auto}
}
</style>
<script>document.documentElement.classList.add('js')</script>
</head>
<body>
<div id="prog" aria-hidden="true"></div>
<button id="totop" aria-label="Back to top"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M12 19V5M5 12l7-7 7 7"/></svg></button>

<header class="top">
  <div class="wrap">
    <a class="logo" href="#"><i>PV</i>Pushpraj Verma</a>
    <nav aria-label="Main"><ul>
      <li><a href="#services">Services</a></li>
      <li><a href="#work">Work</a></li>
      <li><a href="#experience">Experience</a></li>
      <li><a class="btn primary sm" href="#contact">Hire me</a></li>
    </ul></nav>
  </div>
</header>

<div class="hero">
  <span class="blob b1"></span><span class="blob b2"></span><span class="blob b3"></span><canvas id="net" aria-hidden="true"></canvas>
  <div class="wrap hero-grid">
    <div>
      <span class="status intro-anim" style="animation-delay:.05s"><span class="pulse"></span>Open to freelance projects</span>
      <h1 class="intro-anim" style="animation-delay:.15s">Hi, I’m <span class="grad">Pushpraj.</span></h1>
      <p class="typed intro-anim" style="animation-delay:.3s" aria-live="polite">I build <span class="word" id="word">WordPress websites</span><span class="caret"></span></p>
      <p class="lede intro-anim" style="animation-delay:.4s">Full-stack software engineer with 5.6 years of experience creating fast, secure websites, React interfaces and online stores for clients in India, Singapore, Ireland and beyond.</p>
      <div class="ctas intro-anim" style="animation-delay:.5s">
        <a class="btn primary" href="#work">View my work</a>
        <a class="btn" href="mailto:av605370@gmail.com">Email me</a>
      </div>
      <div class="stats intro-anim" style="animation-delay:.6s">
        <div class="stat"><b data-count="5.6" data-dec="1">5.6</b><span>Years of experience</span></div>
        <div class="stat"><b data-count="150" data-suf="+">150+</b><span>Projects completed</span></div>
        <div class="stat"><b data-count="5">5</b><span>Companies</span></div>
      </div>
    </div>

    <div class="hero-right intro-anim" style="animation-delay:.35s">
      <div class="browser" id="browser" aria-label="Preview of client websites">
        <div class="chrome">
          <div class="dots"><i></i><i></i><i></i></div>
          <div class="url"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg><span id="url">gogowash.com.sg</span></div>
        </div>
        <div class="load"><i></i></div>
